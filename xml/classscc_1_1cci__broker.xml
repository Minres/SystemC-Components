        <type>void</type>
        <definition>void scc::cci_broker::set_preset_cci_value</definition>
        <argsstring>(const std::string &amp;parname, const cci::cci_value &amp;cci_value, const cci::cci_originator &amp;originator) override</argsstring>
        <name>set_preset_cci_value</name>
