        <initializer>    union typeName {                                                                                                                       \
        struct {                                                                                                                           \
            T val;                                                                                                                         \
        } backing;                                                                                                                         \
        typeName(T v = 0) { backing.val = v; }                                                                                             \
        typeName&amp; operator=(T v) {                                                                                                         \
            backing.val = v;                                                                                                               \
            return *this;                                                                                                                  \
        }                                                                                                                                  \
        operator T&amp;() { return backing.val; }                                                                                              \
        operator T() const { return backing.val; }                                                                                         \
